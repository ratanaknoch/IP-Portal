rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================
    // 2. Hardened Global Primitives & Role Verification
    // =========================================================
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidIsoTimestamp(ts) {
      return ts is string &&
        ts.size() >= 20 &&
        ts.size() <= 30 &&
        ts.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$');
    }

    function isValidGroupId(groupId) {
      return groupId is string && groupId in [
        'I1-G1', 'I1-G2', 'I1-G3', 'I1-G4', 'I1-G5',
        'I2-SE', 'I2-AIECS', 'I2-CMIE',
        'I3-SE', 'I3-AIECS',
        'I4-SE', 'I4-AIECS',
        'I5', 'Alumni'
      ];
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email == 'ratanaknochmunny@gmail.com';
    }

    function hasStoredRole(roleName) {
      return isVerified() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == roleName;
    }

    function isAdmin() {
      return isBootstrappedAdmin() || hasStoredRole('admin');
    }

    function isMonitor() {
      return hasStoredRole('monitor');
    }

    function isMonitorOrAdmin() {
      return isAdmin() || isMonitor();
    }

    function isMonitorForGroup(targetGroupId) {
      return isVerified() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'monitor' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.groupId == targetGroupId;
    }

    function isAppendingOwnUidOnly(oldList, newList) {
      return newList is list &&
        oldList is list &&
        newList.hasAll(oldList) &&
        newList.size() >= oldList.size() &&
        newList.size() <= oldList.size() + 1 &&
        newList.removeAll(oldList).hasOnly([request.auth.uid]);
    }

    // =========================================================
    // 3. Entity Validation Blueprints (Anti-Update-Gap)
    // =========================================================
    function isValidUserProfile(data) {
      return data.keys().hasAll([
        'uid', 'email', 'displayName', 'role', 'year', 'groupId', 'onboardingCompleted', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'uid', 'email', 'displayName', 'role', 'year', 'groupId',
        'onboardingCompleted', 'promotionYear', 'isAlumni', 'createdAt', 'updatedAt'
      ]) &&
      data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
      data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
      data.role is string && data.role in ['student', 'monitor', 'admin'] &&
      data.year is string && data.year in ['I1', 'I2', 'I3', 'I4', 'I5', 'Alumni', 'Admin', 'None'] &&
      isValidGroupId(data.groupId) &&
      data.onboardingCompleted is bool &&
      isValidIsoTimestamp(data.createdAt) &&
      (!('promotionYear' in data) || (data.promotionYear is string && data.promotionYear.size() <= 80)) &&
      (!('isAlumni' in data) || (data.isAlumni is bool)) &&
      (!('updatedAt' in data) || isValidIsoTimestamp(data.updatedAt));
    }

    function isValidMakeupBooking(data) {
      return data.keys().hasAll([
        'course', 'room', 'groupId', 'date', 'day', 'time', 'bookedBy', 'bookedByUid', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'course', 'sessionType', 'room', 'generation', 'groupId', 'date', 'day',
        'time', 'timeSlots', 'bookedBy', 'bookedByUid', 'note', 'createdAt'
      ]) &&
      data.course is string && data.course.size() >= 1 && data.course.size() <= 200 &&
      (!('sessionType' in data) || (data.sessionType is string && data.sessionType in ['Lecture', 'Tutorial', 'Practical'])) &&
      data.room is string && data.room.size() >= 1 && data.room.size() <= 100 &&
      (!('generation' in data) || (data.generation is string && data.generation in ['I1', 'I2', 'I3', 'I4', 'I5', 'Alumni'])) &&
      isValidGroupId(data.groupId) &&
      data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
      data.day is string && data.day in ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'] &&
      data.time is string && data.time.size() >= 1 && data.time.size() <= 150 &&
      (!('timeSlots' in data) || (
        data.timeSlots is list &&
        data.timeSlots.size() <= 8 &&
        data.timeSlots.hasOnly([
          '7h00 - 7h55', '8h00 - 8h55', '9h10 - 10h05', '10h10 - 11h05',
          '13h00 - 13h55', '14h00 - 14h55', '15h10 - 16h05', '16h10 - 17h05',
          '07:00 - 08:30', '08:35 - 10:05', '10:10 - 11:05', '11:10 - 12:05',
          '13:00 - 14:30', '14:35 - 16:05', '16:10 - 17:05', '17:10 - 18:05'
        ]) &&
        (data.timeSlots.size() == 0 || (data.timeSlots[0] is string && data.timeSlots[0].size() <= 50))
      )) &&
      data.bookedBy is string && data.bookedBy.size() >= 1 && data.bookedBy.size() <= 100 &&
      data.bookedByUid is string && data.bookedByUid.size() >= 1 && data.bookedByUid.size() <= 128 &&
      (!('note' in data) || (data.note is string && data.note.size() <= 300)) &&
      isValidIsoTimestamp(data.createdAt);
    }

    function isValidCancelledClass(data) {
      return data.keys().hasAll([
        'groupId', 'day', 'date', 'time', 'course', 'cancelledBy', 'cancelledByUid', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'groupId', 'cohort', 'day', 'date', 'time', 'course', 'type', 'lecturer',
        'room', 'cancelledBy', 'cancelledByUid', 'reason', 'createdAt'
      ]) &&
      isValidGroupId(data.groupId) &&
      (!('cohort' in data) || (data.cohort is string && data.cohort in ['I1', 'I2', 'I3', 'I4', 'I5', 'Alumni'])) &&
      data.day is string && data.day in ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'] &&
      data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
      data.time is string && data.time.size() >= 1 && data.time.size() <= 100 &&
      data.course is string && data.course.size() >= 1 && data.course.size() <= 200 &&
      (!('type' in data) || (data.type is string && data.type in ['Lecture', 'Practical', 'TP', 'Tutorial', 'Lab'])) &&
      (!('lecturer' in data) || (data.lecturer is string && data.lecturer.size() <= 150)) &&
      (!('room' in data) || (data.room is string && data.room.size() <= 100)) &&
      data.cancelledBy is string && data.cancelledBy.size() >= 1 && data.cancelledBy.size() <= 100 &&
      data.cancelledByUid is string && data.cancelledByUid.size() >= 1 && data.cancelledByUid.size() <= 128 &&
      (!('reason' in data) || (data.reason is string && data.reason.size() <= 300)) &&
      isValidIsoTimestamp(data.createdAt);
    }

    function isValidNotification(data) {
      return data.keys().hasAll([
        'title', 'message', 'audience', 'senderUid', 'createdAt', 'readBy', 'clearedBy'
      ]) &&
      data.keys().hasOnly([
        'id', 'title', 'message', 'audience', 'senderUid', 'senderName', 'senderRole', 'type', 'createdAt', 'readBy', 'clearedBy'
      ]) &&
      (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
      data.message is string && data.message.size() >= 1 && data.message.size() <= 1000 &&
      data.audience is string && data.audience in ['all', 'monitors', 'students'] &&
      data.senderUid is string && data.senderUid.size() >= 1 && data.senderUid.size() <= 128 &&
      (!('senderName' in data) || (data.senderName is string && data.senderName.size() <= 100)) &&
      (!('senderRole' in data) || (data.senderRole is string && data.senderRole.size() <= 60)) &&
      (!('type' in data) || (data.type is string && data.type in ['announcement', 'class_booking', 'system'])) &&
      isValidIsoTimestamp(data.createdAt) &&
      data.readBy is list && data.readBy.size() <= 500 && (data.readBy.size() == 0 || (data.readBy[0] is string && data.readBy[0].size() <= 128)) &&
      data.clearedBy is list && data.clearedBy.size() <= 500 && (data.clearedBy.size() == 0 || (data.clearedBy[0] is string && data.clearedBy[0].size() <= 128));
    }

    // =========================================================
    // 4. Collection Match Blocks
    // =========================================================

    // 4.1 User Profiles & Roles (PII Isolated, Monitor Group-Locked, Root Admin Protected)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && isVerified() && (isAdmin() || resource.data.uid == request.auth.uid);

      allow create: if isSignedIn() && isVerified() && isValidId(userId) && isValidUserProfile(incoming()) && (
        isAdmin() ||
        (
          isOwner(userId) &&
          incoming().uid == request.auth.uid &&
          incoming().email == request.auth.token.email &&
          (
            incoming().role == 'student' ||
            (isBootstrappedAdmin() && incoming().role == 'admin')
          )
        )
      );

      allow update: if isSignedIn() && isVerified() && isValidId(userId) && isValidUserProfile(incoming()) &&
        (existing().email != 'ratanaknochmunny@gmail.com' || incoming().role == 'admin') && (
          isAdmin() ||
          (
            isOwner(userId) &&
            incoming().uid == existing().uid &&
            incoming().email == existing().email &&
            incoming().role == existing().role &&
            incoming().createdAt == existing().createdAt &&
            (existing().role != 'monitor' || (
              incoming().groupId == existing().groupId &&
              incoming().year == existing().year
            )) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'year', 'groupId', 'onboardingCompleted', 'promotionYear', 'isAlumni', 'updatedAt'
            ])
          )
        );

      allow delete: if isSignedIn() && isVerified() && isValidId(userId) && isAdmin() &&
        existing().email != 'ratanaknochmunny@gmail.com';
    }

    // 4.2 Make-up Class Bookings (Authenticated Read, Group-Scoped Monitor or Admin Write, Zero Email PII)
    match /makeupBookings/{bookingId} {
      allow get: if isSignedIn() && isVerified() && isValidId(bookingId);
      allow list: if isSignedIn() && isVerified() && resource.data.createdAt is string;

      allow create: if isSignedIn() && isVerified() && isValidId(bookingId) && isValidMakeupBooking(incoming()) &&
        (isAdmin() || isMonitorForGroup(incoming().groupId)) &&
        incoming().bookedByUid == request.auth.uid;

      allow update: if isSignedIn() && isVerified() && isValidId(bookingId) && isValidMakeupBooking(incoming()) && (
        isAdmin() ||
        (
          isMonitorForGroup(existing().groupId) &&
          (!('bookedByUid' in existing()) || existing().bookedByUid == request.auth.uid) &&
          incoming().groupId == existing().groupId &&
          incoming().bookedByUid == request.auth.uid &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'course', 'sessionType', 'room', 'generation', 'date', 'day', 'time', 'timeSlots', 'note', 'bookedByUid'
          ])
        )
      );

      allow delete: if isSignedIn() && isVerified() && isValidId(bookingId) && (
        isAdmin() ||
        (
          isMonitorForGroup(existing().groupId) &&
          (!('bookedByUid' in existing()) || existing().bookedByUid == request.auth.uid)
        )
      );
    }

    // 4.3 Cancelled Classes (Authenticated Read, Group-Scoped Monitor or Admin Write, Zero Email PII)
    match /cancelledClasses/{cancelId} {
      allow get: if isSignedIn() && isVerified() && isValidId(cancelId);
      allow list: if isSignedIn() && isVerified() && resource.data.createdAt is string;

      allow create: if isSignedIn() && isVerified() && isValidId(cancelId) && isValidCancelledClass(incoming()) &&
        (isAdmin() || isMonitorForGroup(incoming().groupId)) &&
        incoming().cancelledByUid == request.auth.uid;

      allow update: if isSignedIn() && isVerified() && isValidId(cancelId) && isValidCancelledClass(incoming()) && (
        isAdmin() ||
        (
          isMonitorForGroup(existing().groupId) &&
          (!('cancelledByUid' in existing()) || existing().cancelledByUid == request.auth.uid) &&
          incoming().groupId == existing().groupId &&
          incoming().cancelledByUid == request.auth.uid &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['reason', 'cancelledByUid'])
        )
      );

      allow delete: if isSignedIn() && isVerified() && isValidId(cancelId) && (
        isAdmin() ||
        (
          isMonitorForGroup(existing().groupId) &&
          (!('cancelledByUid' in existing()) || existing().cancelledByUid == request.auth.uid)
        )
      );
    }

    // 4.4 Notifications & Broadcasts (Audience-Scoped Read, Role-Gated Broadcast, Monotonic Self-UID Read-Receipts)
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isVerified() && isValidId(notificationId) && (
        resource.data.audience == 'all' ||
        (resource.data.audience == 'students' && isSignedIn()) ||
        (resource.data.audience == 'monitors' && isMonitorOrAdmin()) ||
        isAdmin()
      );
      allow list: if isSignedIn() && isVerified() && (
        resource.data.audience == 'all' ||
        (resource.data.audience == 'students' && isSignedIn()) ||
        (resource.data.audience == 'monitors' && isMonitorOrAdmin()) ||
        isAdmin()
      );

      allow create: if isSignedIn() && isVerified() && isValidId(notificationId) && isValidNotification(incoming()) &&
        incoming().senderUid == request.auth.uid &&
        incoming().clearedBy.size() == 0 &&
        incoming().readBy.hasOnly([request.auth.uid]) && (
          isAdmin() ||
          (
            isMonitor() &&
            incoming().type == 'class_booking' &&
            incoming().senderRole == 'Class Monitor' &&
            incoming().senderName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
          )
        );

      allow update: if isSignedIn() && isVerified() && isValidId(notificationId) && isValidNotification(incoming()) && (
        isAdmin() ||
        (
          incoming().title == existing().title &&
          incoming().message == existing().message &&
          incoming().audience == existing().audience &&
          incoming().senderUid == existing().senderUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['readBy', 'clearedBy']) &&
          isAppendingOwnUidOnly(existing().readBy, incoming().readBy) &&
          isAppendingOwnUidOnly(existing().clearedBy, incoming().clearedBy)
        )
      );

      allow delete: if isSignedIn() && isVerified() && isValidId(notificationId) && isAdmin();
    }
  }
}
