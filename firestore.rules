rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety rule
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Makeup class bookings
    match /makeupBookings/{bookingId} {
      // Public timetable and room schedule viewable by all students
      allow read: if true;
      // Creation allowed with valid ID
      allow create: if isValidId(bookingId);
      // Cancellation / deletion
      allow delete: if isValidId(bookingId);
      allow update: if false;
    }

    // User profiles & roles
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId);
      allow delete: if isValidId(userId);
    }

    // Announcements and notifications inbox
    match /notifications/{notificationId} {
      allow read: if true;
      allow create, update, delete: if isValidId(notificationId);
    }
  }
}
