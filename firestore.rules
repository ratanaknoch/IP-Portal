rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['course', 'room', 'generation', 'groupId', 'date', 'day', 'time', 'bookedBy', 'createdAt'])
        && data.keys().hasOnly(['course', 'room', 'generation', 'groupId', 'date', 'day', 'time', 'bookedBy', 'note', 'createdAt'])
        && data.course is string && data.course.size() > 0 && data.course.size() <= 200
        && data.room is string && data.room.size() > 0 && data.room.size() <= 100
        && data.generation in ['I2', 'I3', 'I4']
        && data.groupId is string && data.groupId.size() > 0 && data.groupId.size() <= 50
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.day in ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday']
        && data.time is string && data.time.size() > 0 && data.time.size() <= 50
        && data.bookedBy is string && data.bookedBy.size() > 0 && data.bookedBy.size() <= 50
        && (!('note' in data) || (data.note is string && data.note.size() <= 300))
        && data.createdAt is string && data.createdAt.size() <= 50;
    }

    match /makeupBookings/{bookingId} {
      // Public timetable and room schedule viewable by all students
      allow read: if true;
      
      // Creation validated against schema constraints
      allow create: if isValidId(bookingId) && isValidBooking(request.resource.data);
      
      // Cancellation / deletion
      allow delete: if isValidId(bookingId);

      // In-place updates forbidden (cancellation is done by delete)
      allow update: if false;
    }
  }
}
